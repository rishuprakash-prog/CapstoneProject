# Copy this file to .streamlit/secrets.toml (local) or paste into
# Streamlit Community Cloud -> App -> Settings -> Secrets. Never commit the real file.

# Free key: https://aistudio.google.com/apikey  (no billing needed)
GEMINI_API_KEY = "paste-your-gemini-key-here"

# Optional: comma-separated model fallback order
# GEMINI_MODEL = "gemini-flash-latest,gemini-3.5-flash,gemini-flash-lite-latest"

# Optional (free): Make.com automation — Scenario -> Webhooks -> Custom webhook -> Copy address
MAKE_WEBHOOK_URL = "https://hook.eu2.make.com/your-webhook-id"
# MAKE_DEFAULT_RECIPIENT = "you@example.com"

# Optional (free): Supabase -> Project Settings -> API
SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_KEY = "paste-service-role-or-secret-key-here"
